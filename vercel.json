{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-job-agent": {
      "root": "artifacts/ai-job-agent",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "entrypoint": "app.js"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api-server",
          "format": "url",
          "env": "API_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ai-job-agent"
      }
    }
  ]
}

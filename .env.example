# Generate a random secret of at least 32 characters before first launch.
# Keep your real value in .env; never commit it or share it.
SESSION_SECRET=dev_secret_key_1234567890abcdefghijklmnopqrstuv

# Production Cloud Database (Turso / libSQL):
# Required for Vercel or cloud deployments so auth, API keys, and job records persist.
# Sign up free at https://turso.tech or run: turso db create kazi-scout
# TURSO_DATABASE_URL=libsql://kazi-scout-youruser.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_jwt

# Optional: Local SQLite file path (used only when Turso is not configured)
# SQLITE_PATH=storage/data/ai-job-agent.sqlite

# Optional: choose where CV files are stored.
# CV_STORAGE_PATH=storage/cvs

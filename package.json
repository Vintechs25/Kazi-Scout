{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "db:setup": "node scripts/local.mjs db:setup",
    "dev": "node scripts/local.mjs dev",
    "build": "node scripts/local.mjs build",
    "start": "node scripts/local.mjs start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
